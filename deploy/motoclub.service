[Unit]
Description=Motoclub - servidor do bar (app + API em localhost)
After=network.target

[Service]
Type=simple
ExecStart=/opt/node/bin/node %h/motoclub/server/dist/server.mjs
WorkingDirectory=%h/motoclub
EnvironmentFile=%h/.config/motoclub/env
Environment=TZ=America/Sao_Paulo
Environment=NODE_ENV=production
Restart=always
RestartSec=2

# Endurecimento leve: o processo não precisa de mais que ler o checkout,
# ler/escrever o banco em ~/.local/share/motoclub e ler os segredos em
# ~/.config/motoclub. Nada disso restringe rede porque o servidor já
# liga só em 127.0.0.1 por padrão (BAR_HOST).
#
# PrivateTmp=true medido no ALVO, não inferido de outra máquina: Linux
# Mint 22.3 "zena", systemd 255 (255.4-1ubuntu8.17), numa unidade de
# USUÁRIO. Uma unidade com a opção subiu (exit 0) e o arquivo que ela
# criou em /tmp NÃO apareceu no /tmp real — ou seja, o isolamento está
# ativo de verdade aqui.
#
# Registro de uma correção, porque a diferença é instrutiva: numa máquina
# de desenvolvimento Ubuntu 24.04 esta mesma opção é IGNORADA em silêncio
# em unidade de usuário, porque lá kernel.apparmor_restrict_unprivileged_userns=1
# impede o systemd de montar o namespace. No Mint 22.3 esse sysctl é 0, e
# a opção funciona. Duas bases "Ubuntu 24.04" com comportamento oposto —
# então a medição que vale é a do alvo.
#
# Seguro para este serviço: nada no código de produção usa /tmp
# (verificado por grep em server/ e scripts/), e o lock que coordena o
# serviço com history.mjs/restore.sh fica em <banco>.lock, ao lado do
# banco em ~/.local/share/motoclub — nunca em /tmp. Onde o sysctl estiver
# em 1, a opção degrada para no-op, não para falha.
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
